<Window x:Class="McggCompanion.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalibrasi shop · MCGG Companion" Width="1380" Height="900"
        MinWidth="1040" MinHeight="700" Background="#F3F5F8" FontFamily="Segoe UI" Language="id-ID">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="S02 · Kalibrasi shop" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Pilih area lalu seret kotak pada gambar tetap. Permainan tetap berjalan; semua pilihan di sini hanya menyunting gambar."
                       TextWrapping="Wrap" Margin="0,6,0,10" />
            <WrapPanel>
                <Button Content="Buka PNG" Click="OnOpenImage" AutomationProperties.AutomationId="ImportCalibrationPng" />
                <ComboBox x:Name="RegionChoice" Width="170" SelectionChanged="OnRegionChanged" Margin="0,0,8,0"
                          AutomationProperties.Name="Area yang ditandai" />
                <Button Content="Hapus area terpilih" Click="OnRemoveRegion" />
                <Button x:Name="SaveButton" Content="Simpan anotasi lokal" Click="OnSave" IsEnabled="False"
                        AutomationProperties.AutomationId="SaveCalibrationSample" />
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="#111827" ClipToBounds="True">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="ImageSurface" Width="640" Height="360">
                            <Image x:Name="FrozenImage" Stretch="Fill" />
                            <Canvas x:Name="RegionCanvas" Background="Transparent"
                                    MouseLeftButtonDown="OnDragStart" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd"
                                    LostMouseCapture="OnDragCancelled" />
                        </Grid>
                    </Viewbox>
                </Border>
                <TextBlock x:Name="RegionSummary" Grid.Row="1" TextWrapping="Wrap" Margin="0,10,0,0" />
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Profil sesi" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="ID sesi permainan / rekaman" Margin="0,8,0,0" />
                    <TextBox x:Name="SessionId" AutomationProperties.Name="ID sesi permainan" />
                    <TextBlock Text="Gunakan ID dan kelompok yang sama untuk seluruh gambar dari pertandingan atau rekaman yang sama. Profil dikunci setelah penyimpanan pertama."
                               TextWrapping="Wrap" Foreground="#56657B" Margin="0,0,0,8" />
                    <TextBlock Text="Kelompok data" />
                    <ComboBox x:Name="SplitChoice" AutomationProperties.Name="Kelompok data sesi" />
                    <TextBlock Text="Hero pilot" />
                    <TextBox x:Name="TargetHero" Text="Uranus" />
                    <TextBlock Text="Versi game" />
                    <TextBox x:Name="GameVersion" />
                    <TextBlock Text="Bahasa game" />
                    <TextBox x:Name="GameLanguage" Text="Belum dicatat" />
                    <TextBlock Text="Mode tampilan" />
                    <TextBox x:Name="DisplayMode" />
                    <TextBlock Text="Skala Windows (mis. 100%)" />
                    <TextBox x:Name="WindowsScale" Text="Belum dicatat" />
                    <Separator Margin="0,8" />
                    <TextBlock Text="Label gambar" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Keadaan shop" Margin="0,8,0,0" />
                    <ComboBox x:Name="ShopState" />
                    <TextBlock Text="Gold (kosong = belum terbaca; 0 = nol)" />
                    <TextBox x:Name="Gold" AutomationProperties.Name="Gold pada gambar" />
                    <TextBlock Text="Kapasitas tempat hero" />
                    <ComboBox x:Name="Capacity" />
                    <TextBlock Text="Slot 1–5 dari kiri ke kanan. Isi nama dan harga hanya jika terbaca; jangan menebak."
                               TextWrapping="Wrap" Foreground="#56657B" Margin="0,4,0,8" />
                    <ItemsControl x:Name="SlotLabels">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" />
                                    <TextBlock Text="Nama hero" />
                                    <TextBox Text="{Binding HeroName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Nama hero pada slot" ToolTip="Nama hero; kosong jika belum terbaca" />
                                    <TextBlock Text="Harga (kosong jika belum terbaca)" />
                                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Harga hero pada slot" ToolTip="Harga; kosong jika belum terbaca, 0 jika gratis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Catatan indikator hasil / kondisi sulit" />
                    <TextBox x:Name="OutcomeNotes" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" />
                    <TextBlock Text="Kotak indikator hasil hanya kandidat pengamatan. Gambar tunggal belum membuktikan pembelian berhasil."
                               TextWrapping="Wrap" Foreground="#56657B" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="SaveStatus" Grid.Row="2" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="PNG, potongan area, dan JSON disimpan hanya di folder data pengguna. Area dan label yang belum lengkap boleh disimpan sebagai anotasi awal." />
    </Grid>
</Window>
